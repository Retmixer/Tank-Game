; Steel Frontier — native Godot 4 project
config_version=5

[application]
config/name="Стальной рубеж"
run/main_scene="res://scenes/game.tscn"
config/features=PackedStringArray("4.7")

[autoload]
GameData="*res://scripts/game_data.gd"

[display]
window/size/viewport_width=1600
window/size/viewport_height=900
window/size/window_width_override=1440
window/size/window_height_override=810
window/stretch/mode="canvas_items"

[rendering]
renderer/rendering_method="forward_plus"
renderer/rendering_method.mobile="mobile"
textures/default_filters/use_nearest_mipmap_filter=false
environment/defaults/default_clear_color=Color(0.08, 0.105, 0.11, 1)

[input]
forward={"deadzone":0.2,"events":[Object(InputEventKey,"physical_keycode":87),Object(InputEventKey,"physical_keycode":4194320)]}
backward={"deadzone":0.2,"events":[Object(InputEventKey,"physical_keycode":83),Object(InputEventKey,"physical_keycode":4194322)]}
turn_left={"deadzone":0.2,"events":[Object(InputEventKey,"physical_keycode":65),Object(InputEventKey,"physical_keycode":4194319)]}
turn_right={"deadzone":0.2,"events":[Object(InputEventKey,"physical_keycode":68),Object(InputEventKey,"physical_keycode":4194321)]}
fire={"deadzone":0.2,"events":[Object(InputEventMouseButton,"button_index":1),Object(InputEventKey,"physical_keycode":32)]}
aim={"deadzone":0.2,"events":[Object(InputEventKey,"physical_keycode":4194325)]}
scoreboard={"deadzone":0.2,"events":[Object(InputEventKey,"physical_keycode":4194309)]}
pause={"deadzone":0.2,"events":[Object(InputEventKey,"physical_keycode":4194305)]}
